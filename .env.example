# Alpha Vision edge service configuration (template).
# Copy to .env and fill in locally. .env is git-ignored. NEVER commit real values.
# Real environment variables override .env.

# ---- Camera identity -----------------------------------------------------
CAMERA_ID=camera-01

# ---- Video source: set EXACTLY ONE of the three options --------------------
# Option A (recommended): Hikvision NVR components; the URL is built for you and
# credentials are percent-encoded. DS-7608NXI-K1: channel 1 sub stream = /Streaming/Channels/102
NVR_HOST=
NVR_RTSP_PORT=554
NVR_USERNAME=
NVR_PASSWORD=
NVR_CHANNEL=1
# sub (= x02, low-res, recommended for detection) or main (= x01)
NVR_STREAM=sub

# Option B: full RTSP URL (percent-encode special characters in the password yourself)
# RTSP_URL=rtsp://<username>:<password>@<nvr-ip>:554/Streaming/Channels/102

# Option C: local video file for development only. Events are tagged input_kind=file
# and Telegram alerts are labelled TEST INPUT.
# VIDEO_FILE=tests/fixtures/sample_video5.mp4
# LOOP_VIDEO_FILE=false

# ---- Detection / tracking --------------------------------------------------
FRAME_SAMPLE_FPS=2
MODEL_PATH=yolo11m.pt
TRACKER_CONFIG=bytetrack.yaml
DETECTION_CONFIDENCE=0.35
INFERENCE_IMAGE_SIZE=640
# "" = auto, "cpu", or "0" for the first CUDA GPU (needs a CUDA build of torch)
INFERENCE_DEVICE=

# ---- Stream reliability ----------------------------------------------------
RTSP_OPEN_TIMEOUT_SECONDS=10
RTSP_READ_TIMEOUT_SECONDS=10
STREAM_STALL_TIMEOUT_SECONDS=15
RECONNECT_INITIAL_SECONDS=1
RECONNECT_MAX_SECONDS=60
# Long back-off after an authentication failure (Hikvision locks out IPs after repeated bad logins)
AUTH_FAILURE_BACKOFF_SECONDS=300

# ---- Event publishing to the Cloudflare Worker -----------------------------
# Leave WORKER_URL empty to run locally without sending anything.
# Local: http://127.0.0.1:8787/v1/events   Production: https://<worker>.<account>.workers.dev/v1/events
WORKER_URL=
# Must equal the Worker's INGEST_TOKEN secret (>= 32 chars). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_INGEST_TOKEN=
EVENT_PUBLISH_INTERVAL_SECONDS=30
EVENT_MIN_INTERVAL_SECONDS=2
COUNT_STABLE_SAMPLES=2
PUBLISH_QUEUE_SIZE=100
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_INITIAL_SECONDS=1
HTTP_BACKOFF_MAX_SECONDS=30

# NOTE: the alert threshold, cooldown and Telegram bot token are NOT edge settings.
# They live in the Worker (wrangler.jsonc vars + Cloudflare secrets).

# ---- Local logs / status ---------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
EVENT_LOG_ENABLED=true
STATUS_FILE=logs/status.json
STATUS_INTERVAL_SECONDS=5
